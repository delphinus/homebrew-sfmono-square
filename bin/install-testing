#!/bin/bash -eu
# Installs a testing build of SF Mono Square from a branch. The tap
# delphinus/sfmono-square is left as it is: the formula of the branch is put
# into a local tap of its own, and installed from there.
#
#   bash <(curl -fsSL https://raw.githubusercontent.com/delphinus/homebrew-sfmono-square/feat/more-weights/bin/install-testing)
#
# Set REF to take the formula from another branch or tag. To go back to the
# released one:
#
#   brew uninstall sfmono-square
#   brew untap local/sfmono-square-testing
#   brew install delphinus/sfmono-square/sfmono-square
REPO=delphinus/homebrew-sfmono-square
REF=${REF:-feat/more-weights}
TAP=local/sfmono-square-testing

main() {
  if ! brew tap | grep -qx "$TAP"; then
    brew tap-new --no-git "$TAP"
  fi
  formula=$(brew --repo "$TAP")/Formula/sfmono-square.rb
  curl -fsSL "https://raw.githubusercontent.com/$REPO/$REF/sfmono-square.rb" -o "$formula"
  grep '^  version ' "$formula"
  # NOTE: The formula has the same name as the one in delphinus/sfmono-square,
  # and only one of them can be installed. This removes only the fonts in the
  # Cellar; the copies in ~/Library/Fonts are not touched.
  if brew list --formula --versions sfmono-square >/dev/null; then
    brew uninstall --formula sfmono-square
  fi
  brew install --formula "$TAP/sfmono-square"
  echo "The fonts are in $(brew --prefix sfmono-square)/share/fonts"
}

main "$@"
